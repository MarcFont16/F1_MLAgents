*.log

# blender files
*.blend1
*.blend1.meta

# memory captures
/[Mm]emoryCaptures/

# recordings
/[Rr]ecordings/

# jetbrains rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# visual studio
.vs/

# gradle
.gradle/

# auto-generated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
